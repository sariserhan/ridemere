  "ranges": {
    "transparent": {
      "start": 0,
      "end": 0,
      "description": "Index 0 is always transparent. PNG->palette conversion maps any pixel with alpha<128 (and any pixel not matched in the palette) to index 0; 'keepIndices' imports force source index 0 to transparent.",
      "cite": "src/openrct2/drawing/PaletteIndex.h:19 (PaletteIndex::transparent = 0); src/openrct2/drawing/ImageImporter.cpp:22,152-156,375-378 (kPaletteTransparent=-1, index 0 forced transparent, alpha<128 test); /home/ssari/projects/theme-park/.cache/libsawyer/src/ImageConverter.h:13 (TransparentIndex = 0); /home/ssari/projects/theme-park/.cache/libsawyer/src/ImageConverter.cpp:78-96"
    },
    "specialMisc": {
      "start": 1,
      "end": 9,
      "description": "Indices 1-9: 'Misc. e.g. font, water, chain lift'. Treated as PaletteIndexType::special (never dithered into, non-remappable). PaletteIndex::fontFill = 1. The secondary/tertiary remap tables additionally redirect source indices 1,2,3 -> 243,244,245.",
      "cite": "src/openrct2/drawing/ImageImporter.h:104 (comment); src/openrct2/drawing/ImageImporter.cpp:402-403 (paletteIndex <= 9 -> special); src/openrct2/drawing/PaletteIndex.h:20 (fontFill = 1); src/openrct2/drawing/Drawing.Sprite.cpp:47-48,67-68 (0x00,0xF3,0xF4,0xF5,...)"
    },
    "specialNonRemappable": {
      "start": 0,
      "end": 9,
      "description": "Together with 230-239 and 255 these are the 10+10+1 'special' indices that image import must never dither into or reassign (0-9 = transparent + font/water/chain-lift, 230-239 = animated water, 255 = pure white).",
      "cite": "src/openrct2/drawing/ImageImporter.cpp:400-415 (GetPaletteIndexType); /home/ssari/projects/theme-park/.cache/libsawyer/src/ImageConverter.cpp:219-234"
    },
    "dynamic": {
      "start": 10,
      "end": 245,
      "description": "kPaletteOffsetDynamic = PaletteIndex::pi10 (10), kPaletteLengthDynamic = 236 -> indices 10..245. This is the block loaded from the water object's main palette G1 sprite and re-uploaded on day/night, lightning and gloom changes. It is also exactly the block stored in resources/palettes/sprites.json (index:10, 236 colours).",
      "cite": "src/openrct2/drawing/Palette.cpp:29-30, 241-242 (GfxTransposePalette), 275 (LoadPalette); resources/palettes/sprites.json:3-241"
    },
